# .env.example  —  copy to .env and fill in your values
# ----------------------------------------------------------
# Dashboard auth
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=honeyguard_admin
DASHBOARD_SECRET_KEY=change_me_to_a_random_secret

# SSH honeypot port (needs to be open on the host)
HONEYPOT_PORT=2222
HONEYPOT_HOST=0.0.0.0

# Firewall auto-block (True = dry-run/simulation, False = real iptables)
DRY_RUN=True

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=False

# Detection thresholds
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW=60
CRED_STUFFING_THRESHOLD=4
CRED_STUFFING_WINDOW=120
PORT_SCAN_THRESHOLD=5
PORT_SCAN_WINDOW=30

# Cloud deploy: set PORT to override dashboard binding to 0.0.0.0
# PORT=10000
